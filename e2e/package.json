{
  "name": "lms-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end browser tests (Playwright) for the running LMS",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "install-browsers": "playwright install chromium",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "mongodb": "^6.10.0"
  }
}
