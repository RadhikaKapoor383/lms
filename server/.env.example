# Server
NODE_ENV=development
PORT=8000
ORIGIN=http://localhost:3000

# Database
DB_URL=mongodb://localhost:27017/lms

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# JWT secrets (generate long random strings for each)
ACTIVATION_SECRET=replace_with_random_string
ACCESS_TOKEN=replace_with_random_string
REFRESH_TOKEN=replace_with_random_string

# Token expiry (in minutes / days respectively)
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3

# Cloudinary
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_SECRET_KEY=your_api_secret

# SMTP (Gmail example - use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Payments. "simulated" = no real money, anyone can "buy" a paid course (dev only).
# Leave unset: defaults to simulated outside production and OFF in production.
PAYMENT_MODE=simulated
